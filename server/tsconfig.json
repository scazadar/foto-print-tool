{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "dist",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts", "../shared/**/*.json"],
  "exclude": ["src/**/*.test.ts", "../shared/**/*.test.ts"]
}
